# crimsonglow.ca document root.
# Managed in github.com/kjiwa/crimsonglow — edit there, not on the server.

# Serve the site's own 404. Inherited by /~kjiwa/, so it covers the whole tree.
ErrorDocument 404 /~kjiwa/404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The document root is a lobby; all content lives under /~kjiwa/. Runs first
  # and host-agnostically so a root request on either host lands in one hop
  # instead of bouncing through the apex first. The target is absolute because
  # a relative one would redirect to the request's own Host header, www
  # included — and a scheme://-prefixed target defaults to 302, so [R=301]
  # has to be explicit.
  RewriteRule ^$ https://crimsonglow.ca/~kjiwa/ [R=301,L]

  # Canonical host is the apex. Root is handled above, so only non-root paths
  # reach this rule.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Legacy URLs. Four predate the /year/month/ permalink scheme; one is an old
  # slug for a post since retitled. Inbound links and search results still
  # point at them, so they redirect rather than 404. Patterns have no leading
  # slash: in a docroot .htaccess mod_rewrite matches the path with it already
  # stripped.
  #
  # The targets are relative, which means mod_rewrite fills in the host and
  # scheme from the request. Both are safe: the www rule above has already
  # forced the apex, and this host terminates TLS in Apache itself rather than
  # at a proxy, so an https request is still seen as https here. If that ever
  # changes these would start emitting http:// and pick up an extra hop
  # through the server's force-https redirect.
  RewriteRule ^~kjiwa/x86-dos-boot-sector-in-c\.html$ /~kjiwa/2010/09/dos-boot-sector.html [R=301,L]
  RewriteRule ^~kjiwa/adding-namespaces-to-java-properties\.html$ /~kjiwa/2012/02/namespaces-in-java-properties.html [R=301,L]
  RewriteRule ^~kjiwa/java-skip-list\.html$ /~kjiwa/2011/06/skip-list.html [R=301,L]
  RewriteRule ^~kjiwa/kde_programming\.html$ /~kjiwa/2004/09/introduction-to-kde-programming.html [R=301,L]
  RewriteRule ^~kjiwa/2016/11/technical-job-search\.html$ /~kjiwa/2016/11/software-job-search.html [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  # Both .js names: Apache's mime.types maps js to text/javascript; the host
  # doesn't advertise a version, so the older name stays too.
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/xml application/atom+xml text/javascript application/javascript \
    application/ld+json image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  # Both .js names: Apache's mime.types maps js to text/javascript; the host
  # doesn't advertise a version, so the older name stays too.
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
    application/xml application/atom+xml text/javascript application/javascript \
    application/ld+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # No includeSubDomains or preload: both are effectively one-way commitments.
  Header always set Strict-Transport-Security "max-age=15768000"

  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # style-src unsafe-inline is deliberate: every page carries its stylesheet
  # inline. frame-src covers the Slides embed in the 2016 job-search post.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; frame-src https://docs.google.com; frame-ancestors 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; connect-src 'none'"

  # HTML carries its stylesheet inline and legacy-redirect.js is generated from
  # the post list, so both must stay short-lived.
  <FilesMatch "\.(html|xml|txt|js)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>

  # Asset filenames are unversioned, so max-age is also the propagation delay
  # for a regenerated card or favicon. 30 days, not a year, for that reason.
  <FilesMatch "\.(png|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
